{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-tests",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": true
  },
  "include": [
    "src/types/graph.ts",
    "src/types/trace.ts",
    "src/types/validation.ts",
    "src/utils/buildRuntimeGraph.ts",
    "src/utils/buildRuntimeGraph.test.ts"
  ]
}
