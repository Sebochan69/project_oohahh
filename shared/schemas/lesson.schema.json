{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooh-ahh.dev/schemas/lesson.schema.json",
  "title": "OOH-AHH Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "difficulty",
    "topic",
    "mode_support",
    "starter_files",
    "learning_objectives",
    "expected_output",
    "required_concepts",
    "validation",
    "hints"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema reference used by lesson JSON files."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "lesson_type": {
      "type": "string",
      "description": "Lesson family. Defaults conceptually to python_foundation when omitted for existing V1 lessons.",
      "enum": ["python_foundation", "backend_lifecycle"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "mode_support": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["beginner", "engineer"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "starter_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/starter_file"
      },
      "minItems": 1
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "request_method": {
      "type": "string",
      "description": "Optional backend lesson HTTP method.",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    "request_path": {
      "type": "string",
      "description": "Optional backend lesson request path, such as /hello.",
      "minLength": 1
    },
    "request_body": {
      "description": "Optional backend lesson sample request body."
    },
    "query_params": {
      "type": "object",
      "description": "Optional backend lesson query parameters.",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "expected_response": {
      "description": "Optional backend lesson expected response payload."
    },
    "expected_status_code": {
      "type": "integer",
      "description": "Optional backend lesson expected HTTP status code.",
      "minimum": 100,
      "maximum": 599
    },
    "lifecycle_nodes": {
      "type": "array",
      "description": "Optional backend lifecycle nodes that a future visualizer can render.",
      "items": {
        "$ref": "#/$defs/lifecycle_node"
      }
    },
    "required_concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy", "rules"],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "starter_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      }
    },
    "lifecycle_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "client",
            "route",
            "validation",
            "service",
            "repository",
            "database",
            "response",
            "error"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
