{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooh-ahh.dev/schemas/lesson.schema.json",
  "title": "OOH-AHH Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "difficulty",
    "topic",
    "mode_support",
    "starter_files",
    "learning_objectives",
    "expected_output",
    "required_concepts",
    "validation",
    "hints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "mode_support": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["beginner", "engineer"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "starter_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/starter_file"
      },
      "minItems": 1
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "required_concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy", "rules"],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "starter_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      }
    }
  }
}
