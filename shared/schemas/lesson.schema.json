{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooh-ahh.dev/schemas/lesson.schema.json",
  "title": "OOH-AHH Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "difficulty",
    "topic",
    "mode_support",
    "starter_files",
    "learning_objectives",
    "expected_output",
    "required_concepts",
    "validation",
    "hints"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema reference used by lesson JSON files."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "lesson_type": {
      "type": "string",
      "description": "Lesson family. Defaults conceptually to python_foundation when omitted for existing V1 lessons.",
      "enum": ["python_foundation", "backend_lifecycle", "ai_rag_pipeline"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "mode_support": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["beginner", "engineer"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "starter_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/starter_file"
      },
      "minItems": 1
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "request_method": {
      "type": "string",
      "description": "Optional backend lesson HTTP method.",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    "request_path": {
      "type": "string",
      "description": "Optional backend lesson request path, such as /hello.",
      "minLength": 1
    },
    "request_body": {
      "description": "Optional backend lesson sample request body."
    },
    "query_params": {
      "type": "object",
      "description": "Optional backend lesson query parameters.",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "expected_response": {
      "description": "Optional backend lesson expected response payload."
    },
    "expected_status_code": {
      "type": "integer",
      "description": "Optional backend lesson expected HTTP status code.",
      "minimum": 100,
      "maximum": 599
    },
    "lifecycle_nodes": {
      "type": "array",
      "description": "Optional backend lifecycle nodes that a future visualizer can render.",
      "items": {
        "$ref": "#/$defs/lifecycle_node"
      }
    },
    "user_query": {
      "type": "string",
      "description": "Optional AI/RAG lesson user query or prompt input."
    },
    "documents": {
      "type": "array",
      "description": "Optional AI/RAG source documents for planning or mock visualization.",
      "items": {
        "$ref": "#/$defs/rag_document"
      }
    },
    "chunks": {
      "type": "array",
      "description": "Optional AI/RAG chunk metadata derived from documents.",
      "items": {
        "$ref": "#/$defs/rag_chunk"
      }
    },
    "embedding_model": {
      "type": "object",
      "description": "Optional AI/RAG embedding model metadata. This is descriptive only.",
      "additionalProperties": true
    },
    "vector_store": {
      "type": "object",
      "description": "Optional AI/RAG vector store metadata. This does not imply a real dependency.",
      "additionalProperties": true
    },
    "retrieved_context": {
      "type": "array",
      "description": "Optional AI/RAG retrieved context chunks or summaries.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "citation_sources": {
      "type": "array",
      "description": "Optional AI/RAG citation/source grounding metadata.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "hallucination_risk_points": {
      "type": "array",
      "description": "Optional AI/RAG risk markers for unsupported or weakly grounded responses.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pipeline_nodes": {
      "type": "array",
      "description": "Optional AI/RAG pipeline nodes for future mock graph rendering.",
      "items": {
        "$ref": "#/$defs/rag_pipeline_node"
      }
    },
    "required_concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy", "rules"],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "starter_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      }
    },
    "lifecycle_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "client",
            "route",
            "validation",
            "service",
            "repository",
            "database",
            "response",
            "error"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "beginner_explanation": {
          "type": "string",
          "description": "Short learner-friendly explanation for Beginner Mode."
        },
        "engineer_explanation": {
          "type": "string",
          "description": "More technical explanation for Engineer Mode."
        },
        "file_path": {
          "type": "string"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rag_document": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "content"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "rag_chunk": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "document_id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "token_estimate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rag_pipeline_node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "user_query",
            "document",
            "chunker",
            "embedding_model",
            "vector_store",
            "retriever",
            "context_builder",
            "llm",
            "response",
            "citation_source",
            "warning_risk"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
