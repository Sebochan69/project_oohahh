# Backend environment variables
#
# Copy this file to `.env` for local development if you need environment-based
# configuration. Do not commit real API keys.

OOH_AHH_ENVIRONMENT=local

# Optional future AI Mentor configuration.
# The backend and mentor placeholder endpoint run without OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
